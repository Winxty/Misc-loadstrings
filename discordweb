local Api = {}

local HttpService = cloneref(game:GetService("HttpService"))

Api.Webhook = nil
Api.Queue = {}

function Api:SetWebhook(Link)
	assert(type(Link) == "string", "Webhook must be a string")

	self.Webhook = Link
end

function Api:Clear()
	self.Webhook = nil
	table.clear(self.Queue)
end

function Api:IsSet()
	return self.Webhook ~= nil
end

function Api:Message(Content)
	assert(self.Webhook, "Webhook has not been set")
	assert(type(Content) == "string", "Message must be a string")

	return request({
		Url = self.Webhook,
		Method = "POST",
		Headers = {
			["Content-Type"] = "application/json"
		},
		Body = HttpService:JSONEncode({
			content = Content
		})
	})
end

function Api:Test()
	assert(self.Webhook, "Webhook has not been set")

	return self:Message("Webhook test successful.")
end

function Api:QueueMessage(Content)
	assert(type(Content) == "string", "Message must be a string")

	table.insert(self.Queue, Content)
end

function Api:Flush()
	assert(self.Webhook, "Webhook has not been set")

	local Queue = self.Queue
	table.clear(self.Queue)

	for _, Content in ipairs(Queue) do
		self:Message(Content)
	end
end

return Api
