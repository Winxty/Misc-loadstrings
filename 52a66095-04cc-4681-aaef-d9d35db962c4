local Api = {}

local function gs(s)
	return game:GetService(s or tostring(s))
end

local Players = cloneref(gs('Players'))
local Workspace = cloneref(gs('Workspace'))
local RunService = cloneref(gs('RunService'))
local MarketplaceService = cloneref(gs('MarketplaceService'))

Api.ApiVersion = "Polaris 1.3"
Api._connections = {}


function Api.ClientIsLoaded()
	return game:IsLoaded()
end

function Api.CharacterExists()
	return Players.LocalPlayer and Players.LocalPlayer.Character ~= nil
end

function Api:GetClient()
	if not self.ClientIsLoaded() then return false end
	if not self.CharacterExists() then return false end

	return {LocalPlayer = Players.LocalPlayer, Character = Players.LocalPlayer.Character}
end

function Api:IsAlive()
	local c = Api:GetClient()
	if not c or not c.Character or not c.LocalPlayer then return false end	

	local humanoid = c.Character:FindFirstChildWhichIsA("Humanoid")

	if humanoid then
		if humanoid.Health <= 0 then return false end
	else
		return false
	end

	return true
end

function Api.GetPosition(part, round)
	local pos

	if part:IsA('BasePart') then
		pos = part.Position
	end

	if part:IsA('Model') then
		pos = part:GetPivot().Position
	end

	if part:IsA("Camera") then
		pos = part.CFrame.Position
	end

	if typeof(part) == "CFrame" then
		return part.Position
	end

	if not pos then return end


	if round then
		return Vector3.new(math.round(pos.X), math.round(pos.Y), math.round(pos.Z))
	else
		return Vector3.new(pos.X, pos.Y, pos.Z)
	end
end

function Api.GetCFrame(object, round)
	local cframe

	if object:IsA("BasePart") then
		cframe = object.CFrame

	elseif object:IsA("Model") then
		cframe = object:GetPivot()

	elseif object:IsA("Camera") then
		cframe = object.CFrame
	end

	if not cframe then return end

	if round then
		return CFrame.new(math.round(cframe.X), math.round(cframe.Y), math.round(cframe.Z))
	else
		return cframe
	end
end

function Api.GetLookVector(object, round)
	local look

	if object:IsA("BasePart") then
		look = object.CFrame.LookVector

	elseif object:IsA("Model") then
		look = object:GetPivot().LookVector

	elseif object:IsA("Camera") then
		look = object.CFrame.LookVector
	end

	if not look then return end

	if round then
		return Vector3.new(math.round(look.X), math.round(look.Y), math.round(look.Z))
	else
		return look
	end
end

function Api.IsAvailable(func)
	return typeof(func) == "function"
end

function Api.RayIgnore(origin, direction, ignore, water)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = ignore or {}
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = water == true
	
	local result = Workspace:Raycast(origin, direction, params)

	if not result then return false end

	return {Instance = result.Instance, Position = result.Position, Distance = result.Distance, Material = result.Material, Normal = result.Normal}
end

function Api.RayInclude(origin, direction, include, water)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = include or {}
	params.FilterType = Enum.RaycastFilterType.Include
	params.IgnoreWater = water == true
	
	local result = Workspace:Raycast(origin, direction, params)

	if not result then return false end

	return {Instance = result.Instance, Position = result.Position, Distance = result.Distance, Material = result.Material, Normal = result.Normal}
end

function Api.Dist(v1, v2)
	return (v1 - v2).Magnitude
end

function Api.GetGame()
	return {GameId = game.GameId, JobId = game.JobId, PlaceId = game.PlaceId, Name = MarketplaceService:GetProductInfo(game.PlaceId), IsPrivateServer = game.PrivateServerId ~= "",}
end

function Api.SafeRequire(module)
	local ok, result = pcall(require, module)
	if ok then return result end

	return false
end

function Api.WorldToScreen(camera, position)
	local screenPos, onScreen = camera:WorldToViewportPoint(position)
	return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

function Api.SafeCall(fn, ...)
	local args = {...}
	local ok, result = pcall(function() return fn(unpack(args)) end)
	if ok then return result end
	return nil, result
end

function Api.Connect(signal, fn)
	local conn = signal:Connect(fn)
	table.insert(Api._connections, conn)
	return conn
end

function Api.DisconnectAll()
	for _, conn in ipairs(Api._connections) do
		if conn.Connected then conn:Disconnect() end
	end
	table.clear(Api._connections)
end

function Api.WaitFor(predicate, timeout)
	local start = tick()
	while not predicate() do
		if timeout and (tick() - start) > timeout then return false end
		RunService.Heartbeat:Wait()
	end
	return true
end


return Api
