local Api = {}

local HttpService = cloneref(game:GetService('HttpService'))

Api.Webhook = nil


function Api:SetWebhook(link)
	self.Webhook = link
end

function Api:Message(Arguments)
    assert(self.Webhook, "Webhook has not been set")
    assert(type(Arguments) == "table", "Arguments must be a table")

    local Color = Arguments.Color or Color3.fromRGB(88, 101, 242)

    local ColorInt =
        math.floor(Color.R * 255) * 256 ^ 2 +
        math.floor(Color.G * 255) * 256 +
        math.floor(Color.B * 255)

    local Embed = {
        title = Arguments.Title,
        description = Arguments.Message,
        color = ColorInt
    }

    if Arguments.Fields then
        Embed.fields = Arguments.Fields
    end

    if Arguments.Footer then
        Embed.footer = {
            text = Arguments.Footer
        }
    end

    if Arguments.Thumbnail then
        Embed.thumbnail = {
            url = Arguments.Thumbnail
        }
    end

    if Arguments.Image then
        Embed.image = {
            url = Arguments.Image
        }
    end

    if Arguments.Author then
        Embed.author = {
            name = Arguments.Author
        }
    end

    return request({
        Url = self.Webhook,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = HttpService:JSONEncode({
            embeds = { Embed }
        })
    })
end

function Api:Error(Message, Arguments)
	assert(self.Webhook, "Webhook has not been set")
	Arguments = Arguments or {}

	Arguments.Title = Arguments.Title or "Error"
	Arguments.Message = Message
	Arguments.Color = Arguments.Color or Color3.fromRGB(237, 66, 69)

	return self:Message(Arguments)
end

function Api:Warn(Message, Arguments)
	assert(self.Webhook, "Webhook has not been set")
	Arguments = Arguments or {}

	Arguments.Title = Arguments.Title or "Warning"
	Arguments.Message = Message
	Arguments.Color = Arguments.Color or Color3.fromRGB(250, 166, 26)

	return self:Message(Arguments)
end

function Api:Log(Message, Arguments)
	assert(self.Webhook, "Webhook has not been set")
	Arguments = Arguments or {}

	Arguments.Title = Arguments.Title or "Log"
	Arguments.Message = Message
	Arguments.Color = Arguments.Color or Color3.fromRGB(88, 101, 242)

	return self:Message(Arguments)
end



return Api
