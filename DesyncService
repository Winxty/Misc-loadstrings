local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Desync = {
    Enabled = false,
    Conn = nil,

    CFrame = nil,

    savedCFrame = nil,
    savedVel = nil,
    savedRotVel = nil,

    RagebotUsing = false,
}

function Desync.SetCFrame(cframe)
    assert(typeof(cframe) == "CFrame", "Desync.SetCFrame: expected CFrame")

    Desync.CFrame = cframe
end

function Desync.GetCFrame()
    return Desync.CFrame
end

function Desync.Start(cframe)
    if cframe ~= nil then
        Desync.SetCFrame(cframe)
    end

    assert(Desync.CFrame, "Desync.Start: CFrame has not been set")

    Desync.Enabled = true

    if Desync.Conn then
        return
    end

    Desync.Conn = RunService.Heartbeat:Connect(function()
        if not Desync.Enabled then
            return
        end

        local char = Players.LocalPlayer.Character
        if not char then
            return
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then
            return
        end

        -- save current state
        Desync.savedCFrame = root.CFrame
        Desync.savedVel = root.Velocity
        Desync.savedRotVel = root.RotVelocity

        -- move to desync position
        root.CFrame = Desync.CFrame

        -- restore after rendering
        RunService:BindToRenderStep(
            "__desync_restore",
            101,
            function()
                local character = Players.LocalPlayer.Character
                local currentRoot = character and character:FindFirstChild("HumanoidRootPart")

                if currentRoot then
                    currentRoot.CFrame = Desync.savedCFrame
                    currentRoot.Velocity = Desync.savedVel
                    currentRoot.RotVelocity = Desync.savedRotVel
                end

                RunService:UnbindFromRenderStep("__desync_restore")
            end
        )
    end)
end

function Desync.Stop()
    Desync.Enabled = false

    if Desync.Conn then
        Desync.Conn:Disconnect()
        Desync.Conn = nil
    end

    RunService:UnbindFromRenderStep("__desync_restore")

    local char = Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if root and Desync.savedCFrame then
        root.CFrame = Desync.savedCFrame
        root.Velocity = Desync.savedVel or Vector3.zero
        root.RotVelocity = Desync.savedRotVel or Vector3.zero
    end
end

function Desync.IsEnabled()
    return Desync.Enabled
end

function Desync.Toggle(cframe)
    if Desync.Enabled then
        Desync.Stop()
        return false
    end

    Desync.Start(cframe)
    return true
end

function Desync.Destroy()
    Desync.Stop()

    Desync.CFrame = nil
    Desync.savedCFrame = nil
    Desync.savedVel = nil
    Desync.savedRotVel = nil
end

return Desync
