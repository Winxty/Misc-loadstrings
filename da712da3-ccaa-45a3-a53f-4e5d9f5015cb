-- Clean Universal Unlocker - Fixed Skins + UI Refresh

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local CosmeticLibrary = require(ReplicatedStorage.Modules:WaitForChild("CosmeticLibrary", 5))
local DataController = require(player.PlayerScripts.Controllers:WaitForChild("PlayerDataController", 5))

local ClientItem = nil
pcall(function()
    ClientItem = require(player.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem)
end)

local equipped = {}  -- weaponName → {Skin = data, Charm = data, Wrap = data, ...}

local function cloneCosmetic(name, cosmeticType)
    local base = CosmeticLibrary.Cosmetics[name]
    if not base then 
        warn("❌ Cosmetic not found:", name)
        return nil 
    end
    local data = table.clone(base)
    data.Name = name
    data.Type = cosmeticType
    data.Seed = data.Seed or math.random(1, 999999)
    return data
end

-- ==================== OWNERSHIP HOOKS ====================

local originalOwns = CosmeticLibrary.OwnsCosmetic
CosmeticLibrary.OwnsCosmetic = function(self, inventory, name, weapon)
    for _, cosmetics in pairs(equipped) do
        for _, c in pairs(cosmetics) do
            if c and c.Name == name then return true end
        end
    end
    return originalOwns(self, inventory, name, weapon)
end

-- Special overrides for Skins (important for some games)
CosmeticLibrary.OwnsCosmeticNormally = function() return true end
CosmeticLibrary.OwnsCosmeticUniversally = function() return true end
CosmeticLibrary.OwnsCosmeticForWeapon = function() return true end

-- ==================== DATA HOOKS ====================

local originalGet = DataController.Get
DataController.Get = function(self, key)
    local data = originalGet(self, key)
    
    if key == "CosmeticInventory" then
        return setmetatable({}, {
            __index = function(_, k)
                for _, cosmetics in pairs(equipped) do
                    for _, c in pairs(cosmetics) do
                        if c and c.Name == k then return true end
                    end
                end
                return nil
            end
        })
    end
    return data
end

local originalWeaponData = DataController.GetWeaponData
DataController.GetWeaponData = function(self, weaponName)
    local data = originalWeaponData(self, weaponName)
    if not data then return nil end

    local merged = table.clone(data)
    merged.Name = weaponName

    if equipped[weaponName] then
        for t, cosmetic in pairs(equipped[weaponName]) do
            merged[t] = cosmetic
        end
    end
    return merged
end

-- ==================== VIEWMODEL HOOKS (Critical for Skins) ====================

local constructingWeapon = nil

if ClientItem and ClientItem._CreateViewModel then
    local orig = ClientItem._CreateViewModel
    ClientItem._CreateViewModel = function(self, viewmodelRef)
        local weaponName = self.Name
        local isLocal = self.ClientFighter and self.ClientFighter.Player == player
        constructingWeapon = isLocal and weaponName or nil

        if isLocal and equipped[weaponName] and viewmodelRef then
            local dataKey = self:ToEnum("Data")
            if viewmodelRef[dataKey] then
                for t, cosmetic in pairs(equipped[weaponName]) do
                    local success, enum = pcall(self.ToEnum, self, t)
                    if success and enum then
                        viewmodelRef[dataKey][enum] = cosmetic
                        viewmodelRef[dataKey][self:ToEnum("Name")] = cosmetic.Name
                    end
                end
            end
        end

        local result = orig(self, viewmodelRef)
        constructingWeapon = nil
        return result
    end
end

-- Extra hook for ClientViewModel.new (very important for skins)
pcall(function()
    local viewModelModule = player.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem:FindFirstChild("ClientViewModel")
    if viewModelModule then
        local ClientViewModel = require(viewModelModule)
        local originalNew = ClientViewModel.new
        
        ClientViewModel.new = function(replicatedData, clientItem)
            local weaponName = constructingWeapon or clientItem.Name
            local isLocal = clientItem.ClientFighter and clientItem.ClientFighter.Player == player

            if isLocal and equipped[weaponName] then
                local ReplicatedClass = require(ReplicatedStorage.Modules.ReplicatedClass)
                local dataKey = ReplicatedClass:ToEnum("Data")
                replicatedData[dataKey] = replicatedData[dataKey] or {}

                for t, cosmetic in pairs(equipped[weaponName]) do
                    local success, enum = pcall(ReplicatedClass.ToEnum, ReplicatedClass, t)
                    if success and enum then
                        replicatedData[dataKey][enum] = cosmetic
                    end
                end
            end
            return originalNew(replicatedData, clientItem)
        end
    end
end)

-- ==================== REMOTE HOOK (Block Equip) ====================

local equipRemote = ReplicatedStorage:FindFirstChild("Remotes", true) 
    and ReplicatedStorage.Remotes:FindFirstChild("Data", true)
    and ReplicatedStorage.Remotes.Data:FindFirstChild("EquipCosmetic")

if equipRemote and hookmetamethod then
    local oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if self == equipRemote and getnamecallmethod() == "FireServer" then
            return -- Block real equip
        end
        return oldNamecall(self, ...)
    end)
end

-- ==================== FORCE REFRESH ====================

local function ForceRefresh(weaponName)
    pcall(function()
        if DataController.CurrentData then
            DataController.CurrentData:Replicate("WeaponInventory")
            task.wait(0.1)
            DataController.CurrentData:Replicate("WeaponInventory")
            task.wait(0.1)
            DataController.CurrentData:Replicate("CosmeticInventory")
        end
    end)
end

-- ==================== MAIN FUNCTIONS ====================

local function Unlock(weaponName, cosmeticType, cosmeticName)
    if not weaponName or not cosmeticType or not cosmeticName then
        warn("Usage: Unlock(weaponName, type, cosmeticName)")
        return
    end

    equipped[weaponName] = equipped[weaponName] or {}
    equipped[weaponName][cosmeticType] = cloneCosmetic(cosmeticName, cosmeticType)

    ForceRefresh(weaponName)

    print(`✅ Unlocked → {weaponName} | {cosmeticType} = {cosmeticName}`)
end

local function Lock(weaponName, cosmeticType, cosmeticName)
    if not equipped[weaponName] then return end

    if cosmeticName then
        if equipped[weaponName][cosmeticType] and equipped[weaponName][cosmeticType].Name == cosmeticName then
            equipped[weaponName][cosmeticType] = nil
        end
    else
        equipped[weaponName][cosmeticType] = nil
    end

    if not next(equipped[weaponName]) then
        equipped[weaponName] = nil
    end

    ForceRefresh(weaponName)

    print(`🔒 Locked → {weaponName} | {cosmeticType}{cosmeticName and (" = " .. cosmeticName) or ""}`)
end

return {
    Unlock = Unlock,
    Lock = Lock,
    ForceRefresh = ForceRefresh
}
