-- Stable Unlocker - No Require Error + Better Skin Support

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- Delayed requires
local CosmeticLibrary, DataController, ClientItem = nil, nil, nil

task.wait(1) -- Small delay to avoid load conflicts

pcall(function() CosmeticLibrary = require(ReplicatedStorage.Modules:WaitForChild("CosmeticLibrary", 5)) end)
pcall(function() DataController = require(player.PlayerScripts.Controllers:WaitForChild("PlayerDataController", 5)) end)
pcall(function() ClientItem = require(player.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem) end)

local equipped = {}
local constructingWeapon = nil

local function cloneCosmetic(name, cosmeticType)
    if not CosmeticLibrary then return nil end
    local base = CosmeticLibrary.Cosmetics[name]
    if not base then 
        warn("Cosmetic not found:", name)
        return nil 
    end
    local data = table.clone(base)
    data.Name = name
    data.Type = cosmeticType
    data.Seed = data.Seed or math.random(1, 999999)
    return data
end

-- ==================== HOOKS (Safer) ====================

if CosmeticLibrary then
    local originalOwns = CosmeticLibrary.OwnsCosmetic
    CosmeticLibrary.OwnsCosmetic = function(self, inventory, name, weapon)
        for _, cosmetics in pairs(equipped) do
            for _, c in pairs(cosmetics) do
                if c and c.Name == name then return true end
            end
        end
        return originalOwns(self, inventory, name, weapon)
    end

    -- Skin specific
    CosmeticLibrary.OwnsCosmeticNormally = function() return true end
    CosmeticLibrary.OwnsCosmeticUniversally = function() return true end
    CosmeticLibrary.OwnsCosmeticForWeapon = function() return true end
end

if DataController then
    -- Get hook (safe)
    local originalGet = DataController.Get
    DataController.Get = function(self, key)
        local success, data = pcall(originalGet, self, key)
        if not success then return nil end

        if key == "CosmeticInventory" then
            return setmetatable({}, {
                __index = function(_, k)
                    for _, cosmetics in pairs(equipped) do
                        for _, c in pairs(cosmetics) do
                            if c and c.Name == k then return true end
                        end
                    end
                    return nil
                end
            })
        end
        return data
    end

    -- GetWeaponData - Most dangerous hook, made very safe
    local originalWeaponData = DataController.GetWeaponData
    DataController.GetWeaponData = function(self, weaponName)
        local success, data = pcall(originalWeaponData, self, weaponName)
        if not success or not data then return data end

        local merged = table.clone(data)
        merged.Name = weaponName

        if equipped[weaponName] then
            for t, cosmetic in pairs(equipped[weaponName]) do
                merged[t] = cosmetic
            end
        end
        return merged
    end
end

-- ViewModel Hooks
if ClientItem and ClientItem._CreateViewModel then
    local orig = ClientItem._CreateViewModel
    ClientItem._CreateViewModel = function(self, viewmodelRef)
        local weaponName = self.Name
        local isLocal = self.ClientFighter and self.ClientFighter.Player == player
        constructingWeapon = isLocal and weaponName or nil

        if isLocal and equipped[weaponName] and viewmodelRef then
            local success, dataKey = pcall(self.ToEnum, self, "Data")
            if success and dataKey and viewmodelRef[dataKey] then
                for t, cosmetic in pairs(equipped[weaponName]) do
                    local s, enum = pcall(self.ToEnum, self, t)
                    if s and enum then
                        viewmodelRef[dataKey][enum] = cosmetic
                        pcall(function() viewmodelRef[dataKey][self:ToEnum("Name")] = cosmetic.Name end)
                    end
                end
            end
        end

        local result = orig(self, viewmodelRef)
        constructingWeapon = nil
        return result
    end
end

-- ClientViewModel.new hook (important for skins)
pcall(function()
    local vmModule = player.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem:FindFirstChild("ClientViewModel")
    if vmModule then
        local ClientViewModel = require(vmModule)
        local originalNew = ClientViewModel.new

        ClientViewModel.new = function(replicatedData, clientItem)
            local weaponName = constructingWeapon or (clientItem and clientItem.Name)
            local isLocal = clientItem and clientItem.ClientFighter and clientItem.ClientFighter.Player == player

            if isLocal and weaponName and equipped[weaponName] then
                pcall(function()
                    local ReplicatedClass = require(ReplicatedStorage.Modules.ReplicatedClass)
                    local dataKey = ReplicatedClass:ToEnum("Data")
                    replicatedData[dataKey] = replicatedData[dataKey] or {}

                    for t, cosmetic in pairs(equipped[weaponName]) do
                        local success, enum = pcall(ReplicatedClass.ToEnum, ReplicatedClass, t)
                        if success and enum then
                            replicatedData[dataKey][enum] = cosmetic
                        end
                    end
                end)
            end
            return originalNew(replicatedData, clientItem)
        end
    end
end)

-- Remote block
pcall(function()
    local equipRemote = ReplicatedStorage:FindFirstChild("Remotes", true) and ReplicatedStorage.Remotes:FindFirstChild("Data", true) and ReplicatedStorage.Remotes.Data:FindFirstChild("EquipCosmetic")
    if equipRemote and hookmetamethod then
        local old = hookmetamethod(game, "__namecall", function(self, ...)
            if self == equipRemote and getnamecallmethod() == "FireServer" then
                return
            end
            return old(self, ...)
        end)
    end
end)

-- ==================== FUNCTIONS ====================

local function ForceRefresh(weaponName)
    pcall(function()
        if DataController and DataController.CurrentData then
            DataController.CurrentData:Replicate("WeaponInventory")
            task.wait(0.15)
            DataController.CurrentData:Replicate("WeaponInventory")
        end
    end)
end

local function Unlock(weaponName, cosmeticType, cosmeticName)
    if not weaponName or not cosmeticType or not cosmeticName then return end

    equipped[weaponName] = equipped[weaponName] or {}
    equipped[weaponName][cosmeticType] = cloneCosmetic(cosmeticName, cosmeticType)

    ForceRefresh(weaponName)
    print(`✅ Unlocked {cosmeticName} on {weaponName} ({cosmeticType})`)
end

local function Lock(weaponName, cosmeticType, cosmeticName)
    if not equipped[weaponName] then return end

    if cosmeticName then
        if equipped[weaponName][cosmeticType] and equipped[weaponName][cosmeticType].Name == cosmeticName then
            equipped[weaponName][cosmeticType] = nil
        end
    else
        equipped[weaponName][cosmeticType] = nil
    end

    if not next(equipped[weaponName]) then equipped[weaponName] = nil end

    ForceRefresh(weaponName)
    print(`🔒 Locked on {weaponName}`)
end

return {
    Unlock = Unlock,
    Lock = Lock,
    ForceRefresh = ForceRefresh
}
