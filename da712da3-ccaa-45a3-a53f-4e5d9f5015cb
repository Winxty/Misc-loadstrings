-- Simplified Universal UnlockAll (Supports All Types)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local CosmeticLibrary = require(ReplicatedStorage.Modules:WaitForChild("CosmeticLibrary"))
local DataController = require(player.PlayerScripts.Controllers:WaitForChild("PlayerDataController"))
local ClientItemModule = player.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter:WaitForChild("ClientItem")

local ClientItem = require(ClientItemModule)

local equipped = {}  -- [weaponName] = { Skin = data, Charm = data, Wrap = data, ... }

local function cloneCosmetic(name, cosmeticType)
    local base = CosmeticLibrary.Cosmetics[name]
    if not base then 
        warn("Cosmetic not found:", name)
        return nil 
    end
    local data = table.clone(base)
    data.Name = name
    data.Type = cosmeticType
    data.Seed = data.Seed or math.random(1, 999999)
    return data
end

-- ==================== HOOKS ====================

-- Ownership Hook
local originalOwns = CosmeticLibrary.OwnsCosmetic
CosmeticLibrary.OwnsCosmetic = function(self, inv, name)
    for _, cosmetics in pairs(equipped) do
        for _, c in pairs(cosmetics) do
            if c and c.Name == name then return true end
        end
    end
    return originalOwns(self, inv, name)
end

-- DataController Hook
local originalGet = DataController.Get
DataController.Get = function(self, key)
    local data = originalGet(self, key)
    
    if key == "CosmeticInventory" then
        return setmetatable({}, {
            __index = function(_, name)
                for _, cosmetics in pairs(equipped) do
                    for _, c in pairs(cosmetics) do
                        if c and c.Name == name then return true end
                    end
                end
                return nil
            end
        })
    end
    return data
end

-- Weapon Data Hook
local originalWeaponData = DataController.GetWeaponData
DataController.GetWeaponData = function(self, weaponName)
    local data = originalWeaponData(self, weaponName)
    if not data then return nil end
    
    local merged = table.clone(data)
    merged.Name = weaponName
    
    if equipped[weaponName] then
        for t, cosmetic in pairs(equipped[weaponName]) do
            merged[t] = cosmetic
        end
    end
    return merged
end

-- Equip Remote Hook
local equipRemote = ReplicatedStorage:FindFirstChild("Remotes", true) and 
                   ReplicatedStorage.Remotes:FindFirstChild("Data", true) and 
                   ReplicatedStorage.Remotes.Data:FindFirstChild("EquipCosmetic")

if equipRemote and hookmetamethod then
    local oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if self ~= equipRemote or getnamecallmethod() ~= "FireServer" then
            return oldNamecall(self, ...)
        end
        return -- Block server call
    end)
end

-- ViewModel Hook
if ClientItem and ClientItem._CreateViewModel then
    local orig = ClientItem._CreateViewModel
    ClientItem._CreateViewModel = function(self, ref)
        local weaponName = self.Name
        local isLocalPlayer = self.ClientFighter and self.ClientFighter.Player == player

        if isLocalPlayer and equipped[weaponName] and ref then
            local dataKey = self:ToEnum("Data")
            if ref[dataKey] then
                for t, cosmetic in pairs(equipped[weaponName]) do
                    ref[dataKey][self:ToEnum(t)] = cosmetic
                end
            end
        end
        return orig(self, ref)
    end
end

-- ==================== MAIN FUNCTIONS ====================

local function Unlock(weaponName, cosmeticType, cosmeticName)
    if not weaponName or not cosmeticType or not cosmeticName then
        warn("Unlock: Missing arguments! Usage: Unlock(weapon, type, name)")
        return
    end

    equipped[weaponName] = equipped[weaponName] or {}
    equipped[weaponName][cosmeticType] = cloneCosmetic(cosmeticName, cosmeticType)

    pcall(function()
        DataController.CurrentData:Replicate("WeaponInventory")
    end)

    print(`✅ Unlocked | {weaponName} → {cosmeticType} = {cosmeticName}`)
end

local function Lock(weaponName, cosmeticType, cosmeticName)
    if not equipped[weaponName] then return end

    if cosmeticName then
        -- Remove specific cosmetic
        if equipped[weaponName][cosmeticType] and equipped[weaponName][cosmeticType].Name == cosmeticName then
            equipped[weaponName][cosmeticType] = nil
        end
    else
        -- Remove entire type from weapon
        equipped[weaponName][cosmeticType] = nil
    end

    if not next(equipped[weaponName]) then
        equipped[weaponName] = nil
    end

    pcall(function()
        DataController.CurrentData:Replicate("WeaponInventory")
    end)

    print(`🔒 Locked | {weaponName} → {cosmeticType}{cosmeticName and (" = " .. cosmeticName) or ""}`)
end

-- Return API
return {
    Unlock = Unlock,
    Lock = Lock
}
