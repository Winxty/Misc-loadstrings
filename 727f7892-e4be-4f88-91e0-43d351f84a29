
local Api = {}

cloneref = (cloneref or function(a)
	return a
end)

local function gs(s)
	return cloneref(game:GetService(s or tostring(s)))
end


local Players = gs('Players')
local Workspace = gs('Workspace')
local RunService = gs('RunService')
local ReplicatedStorage = gs("ReplicatedStorage")
local MarketplaceService = gs('MarketplaceService')
local Uis = gs('UserInputService')
local HttpService = gs('HttpService')

Api.Version = "2.1"
Api._connections = {}
Api._caches = {}
Api.IsLoaded = false



-- Signals

function Api.Connect(name, signal, fn)
	local conn = signal:Connect(fn)
	Api._connections[name] = {Signal = signal, Function = fn}
	return conn
end

function Api.Disconnect(name)
    local conn = Api._connections[name]

    if conn then
        if conn.Signal.Connected then
            conn.Signal:Disconnect()
        end

        Api._connections[name] = nil
    end
end

function Api.DisconnectAll()
	for _, conn in pairs(Api._connections) do
		if conn.Signal.Connected then
			conn.Signal:Disconnect()
		end
	end

	table.clear(Api._connections)
end

function Api.WaitFor(predicate, timeout)
	local start = tick()
	while not predicate() do
		if timeout and (tick() - start) > timeout then return false end
		RunService.Heartbeat:Wait()
	end
	return true
end


-- Cache

function Api.CreateCache(name)
	local cch = {cache = {}}

	function cch:Set(name, inst)
		cch.cache[name] = inst
		return cch.cache[name]
	end

	function cch:Get(name)
		return cch.cache[name]
	end

	function cch:Remove(name)
		cch.cache[name] = nil
	end

	function cch:Clear()
		table.clear(cch.cache)
	end

	function cch:Destroy()
		cch = nil
	end

	Api._caches[name] = cch


	return cch
end




